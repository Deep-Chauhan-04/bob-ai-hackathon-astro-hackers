# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# ── IBM Bob Inference API (REQUIRED for AI Copilot layer) ─────────────────────
# Generate an Inference-scoped key at: https://bob.ibm.com → Account → API Keys
BOB_INFERENCE_API_KEY=your_inference_api_key_here

# Bob inference gateway URL (leave as default for trial/us-east accounts)
BOB_INFERENCE_URL=https://api.us-east.bob.ibm.com/inference/v1

# Bob model tier: fast | premium-ide | explorer  (fast is default)
BOB_MODEL=fast

# ── IBM watsonx.ai (optional — not used in current implementation) ─────────────
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Application ───────────────────────────────────────────────────────────────
APP_PORT=8501
APP_ENV=development
